@echo off
chcp 65001 >nul
setlocal EnableExtensions DisableDelayedExpansion
title Claude Code Setup
set "PS=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
if not exist "%PS%" goto missing_powershell
if not exist "%~dp0辅助文件\Setup.ps1" goto missing_package
if not exist "%~dp0辅助文件\configure.cjs" goto missing_package
if not exist "%~dp0辅助文件\dialogs.cjs" goto missing_package
if not exist "%~dp0辅助文件\key-dialog.ps1" goto missing_package
"%PS%" -NoLogo -NoProfile -STA -ExecutionPolicy Bypass -File "%~dp0辅助文件\Setup.ps1"
set "SETUP_EXIT=%ERRORLEVEL%"
goto done
:missing_package
"%PS%" -NoLogo -NoProfile -STA -EncodedCommand 
set "SETUP_EXIT=2"
goto done
:missing_powershell
echo code=BOOT-POWERSHELL-001 stage=bootstrap reason=Windows PowerShell was not found.
echo state=unchanged installation=not-started PATHstate=unchanged
echo Please copy this diagnostic before closing the window.
set "SETUP_EXIT=3"
:done
echo.
echo 流程已结束，请查看上方结果。
echo 按任意键关闭此窗口 . . .
pause >nul
exit /b %SETUP_EXIT%
